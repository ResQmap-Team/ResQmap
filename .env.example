# --- ResQMap AI - Root Environment Configuration ---------------------------------
# Copy this file to .env in the PROJECT ROOT (same folder as this file).
# NEVER commit .env to git - it contains secrets.
#
# This file is loaded by the BACKEND (backend/config.py via python-dotenv).
# Frontend variables live in frontend/.env  (see frontend/.env.example).

# --- Gemini AI -------------------------------------------------------------------
# Get your key from https://aistudio.google.com/app/apikey
# <- YOU MUST SET THIS for AI image classification to work.
GEMINI_API_KEY=

# --- Shared Database (Supabase PostgreSQL) ----------------------------------------
# REQUIRED for physical-system failover across multiple teammate laptops.
# All teammate machines must point to the SAME Supabase connection string.
#
# Steps:
#   1. Create a free project at https://supabase.com
#   2. Project Settings -> Database -> Connection string -> URI
#   3. Copy the URI, change "postgresql://" to "postgresql+asyncpg://"
#   4. Paste below on EVERY teammate machine.
#
# Example format (do not use this - it is not a real credential):
#   DATABASE_URL=postgresql+asyncpg://postgres:YOURPASSWORD@db.YOURREF.supabase.co:5432/postgres
# <- YOU MUST SET THIS for shared multi-machine database sync.
DATABASE_URL=

# --- Local SQLite fallback (single-machine dev only) -----------------------------
# If DATABASE_URL is blank above, SQLite is used automatically.
# Set DB_DIR to a path OUTSIDE OneDrive to avoid sync conflicts.
# Default: project root (inside OneDrive - ok for code, not ideal for DB file).
# Example: DB_DIR=C:\Users\YourName\AppData\Local\resqmap
# DB_DIR=

# --- Backend Node Identity -------------------------------------------------------
# Set a UNIQUE node name per teammate laptop for logging and health checks.
# Examples: node-vivek, node-teammate-a, node-teammate-b
NODE_ID=node-01

# --- Server Binding --------------------------------------------------------------
# Host and port for the uvicorn server.
# HOST must be 0.0.0.0 for LAN access from other devices (phones, other laptops).
# Change PORT only if 8000 is blocked on your machine.
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# --- CORS -----------------------------------------------------------------------
# Comma-separated list of allowed frontend origins.
# Use * for local development only.
# For production / hackathon demo with known frontend hosts:
#   CORS_ORIGINS=http://192.168.1.X:5173,http://192.168.1.Y:5173,http://192.168.1.Z:5173
CORS_ORIGINS=*

# --- TURN Server (WebRTC - required behind strict NAT/firewalls) -----------------
# Optional. Needed for video streaming when STUN alone fails (e.g. mobile data).
# Free options: Metered TURN https://www.metered.ca/tools/openrelay/
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# --- SOS Priority Weights (must sum to 100) --------------------------------------
# Adjust if needed. Defaults: distance 35%, medical 20%, trapped 20%,
# vulnerability 10%, severity 10%, wait time 5%.
SOS_WEIGHT_DISTANCE=35
SOS_WEIGHT_MEDICAL=20
SOS_WEIGHT_TRAPPED=20
SOS_WEIGHT_VULN=10
SOS_WEIGHT_SEVERITY=10
SOS_WEIGHT_WAIT=5

# --- Emergency Outbound Dispatch (SMTP Email Transport) -------------------------
# Standard SMTP server for dispatching emergency notifications to authorities (NDMA, SEOC, 112).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
EMERGENCY_ALERT_RECIPIENTS=ndma.alerts@gov.in,seoc.controlroom@gov.in,rescue-dispatch@112.gov.in
EMERGENCY_REPORT_DESTINATION_LABEL=National Emergency Dispatch Mesh (NDMA / SEOC / 112)
SMTP_USE_TLS=true
SMTP_USE_SSL=false

