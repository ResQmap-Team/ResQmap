# --- ResQMap AI - Frontend Environment -------------------------------------------
# Copy this file to frontend/.env  (same directory as this file, inside frontend/).
# NEVER commit frontend/.env to git - it may contain local IP addresses.
#
# After copying, fill in values marked <- YOU MUST SET THIS.
# Lines without that marker are optional or have safe defaults.

# --- Backend API Nodes (Physical-System Failover) ---------------------------------
# Comma-separated URLs of ALL teammate backend servers, in priority order.
# The frontend health-checks each host in order and automatically fails over
# to the next reachable one.
#
# HOW TO FIND YOUR LAN IP:
#   Windows: run  ipconfig  -> look for "IPv4 Address" under your Wi-Fi adapter
#   macOS:   run  ifconfig  -> look for "inet" under en0
#   Linux:   run  ip addr   -> look for "inet" under eth0 or wlan0
#
# Replace the placeholder IPs below with your actual teammate LAN IPs.
# All machines must be on the SAME Wi-Fi / LAN network for this to work.
# <- YOU MUST SET THIS before running the hackathon demo.
VITE_API_NODES=http://192.168.1.X:8000,http://192.168.1.Y:8000,http://192.168.1.Z:8000

# --- Single Backend URL (simple dev mode fallback) --------------------------------
# Used only when VITE_API_NODES is not set.
# For single-machine local development only.
VITE_API_URL=http://localhost:8000

# NOTE: WebSocket URL is NOT configured separately here.
# The frontend derives the WebSocket URL automatically from the active backend node
# (replaces http:// with ws:// and appends /ws). No manual WS config needed.

# --- HTTPS / ngrok (for Android camera and cross-device testing) ------------------
# Camera access on Android requires HTTPS (browser security policy).
# Use ngrok to tunnel your local backend over HTTPS:
#
#   Step 1 - Install ngrok: https://ngrok.com/download
#   Step 2 - Start backend:  uvicorn backend.main:app --host 0.0.0.0 --port 8000
#   Step 3 - Tunnel backend: ngrok http 8000
#   Step 4 - Copy the https URL (e.g. https://abc123.ngrok-free.app)
#   Step 5 - Set below and restart the frontend dev server.
#
# Uncomment and fill in for ngrok/Android testing:
# VITE_API_NODES=https://abc123.ngrok-free.app
# VITE_API_URL=https://abc123.ngrok-free.app

# --- Gemini API Key (client-side, OPTIONAL) ----------------------------------------
# WARNING: VITE_* variables are embedded in the browser bundle and are
# publicly visible to anyone who opens DevTools. NEVER put a production
# Gemini API key here.
#
# Leave blank in normal operation - the backend uses its own server-side key
# (set in root .env -> GEMINI_API_KEY).
#
# Only set this for fully offline Judge Sandbox testing when no backend is
# running and you want Gemini vision on the frontend directly.
# Use a throwaway / restricted key only.
VITE_GEMINI_API_KEY=
